# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริง  ->  cp api/.env.example api/.env
# api/.env ถูก gitignore ไว้แล้ว ห้าม commit เด็ดขาด

# ===== KKU IntelSphere (OpenAI-compatible) =====
KKU_BASE_URL=https://gen.ai.kku.ac.th/api/v1
KKU_API_KEY=
# ต้องเป็นโมเดลที่รับ image_url ได้ — ถ้าอ่านรูปไม่ออกให้เปลี่ยนตรงนี้ อย่าแก้โค้ด
KKU_VISION_MODEL=gemini-2.5-flash

# ===== Google Cloud Vision (OCR) =====
# ว่างไว้ = ปิด OCR ทั้งระบบ แอปยังใช้งานได้ปกติ (AI จะอ่านจากรูปอย่างเดียวเหมือนเดิม)
# สร้าง key: GCP console -> APIs & Services -> Credentials -> Create API key
# แล้วต้องเปิด "Cloud Vision API" ใน project นั้นด้วย ไม่งั้นจะได้ HTTP 403
# แนะนำให้ล็อก key ด้วย API restrictions ให้เรียกได้เฉพาะ Cloud Vision API
GOOGLE_VISION_API_KEY=
# ใบเสร็จไทยมีอังกฤษปนเสมอ (ชื่อแบรนด์ เลขที่เอกสาร) — บอกใบ้ทั้งสองภาษา
OCR_LANGUAGE_HINTS=th,en
# ความมั่นใจเฉลี่ยต่ำกว่านี้ = ขึ้นแบนเนอร์เตือนว่าภาพอ่านยาก (ไม่ได้บล็อกอะไร)
OCR_QUALITY_THRESHOLD=0.75

# ===== Database (MongoDB) =====
# รันใน Docker ให้เปลี่ยน localhost เป็น host.docker.internal (container ไม่เห็น localhost ของเครื่อง)
MONGODB_URI=mongodb://pukthong_admin:change_me_in_local_env@localhost:27017/pukthong?authSource=admin

# ===== Auth (JWT) =====
# ต้องตั้งค่านี้ ไม่งั้น backend จะไม่ยอมบูต — สุ่มด้วย: openssl rand -hex 32
# เปลี่ยนค่านี้เมื่อไหร่ ทุกคนที่ล็อกอินค้างไว้จะหลุดทันที
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ===== App =====
MAX_IMAGE_LONG_EDGE=2000
BLUR_THRESHOLD=100.0
MAX_UPLOAD_MB=15
# รันในเครื่องเขียนลง /data ไม่ได้ — ใน Docker ถูก override เป็น /data/uploads ให้แล้ว
UPLOAD_DIR=./uploads
CORS_ORIGINS=http://localhost:3000
# true = ยอมรับเครื่องในวง LAN ทุกตัว (10.x / 172.16-31.x / 192.168.x) ทุกพอร์ต
# มีไว้เพื่อทดสอบจากมือถือ โดยไม่ต้องไล่แก้ IP ทุกครั้งที่เราเตอร์แจกเลขใหม่
# ⚠️ ห้ามเปิดตอนขึ้นเซิร์ฟเวอร์จริงที่ออกอินเทอร์เน็ต
CORS_ALLOW_LAN=true
