# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริง  ->  cp api/.env.example api/.env
# api/.env ถูก gitignore ไว้แล้ว ห้าม commit เด็ดขาด

# ===== KKU IntelSphere (OpenAI-compatible) =====
KKU_BASE_URL=https://gen.ai.kku.ac.th/api/v1
KKU_API_KEY=
# ต้องเป็นโมเดลที่รับ image_url ได้ — ถ้าอ่านรูปไม่ออกให้เปลี่ยนตรงนี้ อย่าแก้โค้ด
KKU_VISION_MODEL=gemini-2.5-flash

# ===== Database (MongoDB) =====
# รันใน Docker ให้เปลี่ยน localhost เป็น host.docker.internal (container ไม่เห็น localhost ของเครื่อง)
MONGODB_URI=mongodb://pukthong_admin:change_me_in_local_env@localhost:27017/pukthong?authSource=admin

# ===== Auth (JWT) =====
# ต้องตั้งค่านี้ ไม่งั้น backend จะไม่ยอมบูต — สุ่มด้วย: openssl rand -hex 32
# เปลี่ยนค่านี้เมื่อไหร่ ทุกคนที่ล็อกอินค้างไว้จะหลุดทันที
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ===== App =====
MAX_IMAGE_LONG_EDGE=2000
BLUR_THRESHOLD=100.0
MAX_UPLOAD_MB=15
# รันในเครื่องเขียนลง /data ไม่ได้ — ใน Docker ถูก override เป็น /data/uploads ให้แล้ว
UPLOAD_DIR=./uploads
# เปิดจากมือถือ ให้เพิ่ม http://<IP เครื่อง>:3000 ต่อท้ายด้วย คั่นด้วย comma
CORS_ORIGINS=http://localhost:3000
